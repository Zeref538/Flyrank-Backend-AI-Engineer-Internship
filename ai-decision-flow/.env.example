# Copy to .env.local (which is gitignored) and adjust.

# Tells the Inngest SDK to talk to the local Dev Server instead of Inngest Cloud.
# Without this the /api/inngest route answers 500: "in cloud mode but no signing key".
INNGEST_DEV=1

# LLM_STUB=1 answers with keyword rules: no model, no network, no spending.
LLM_STUB=1

# For a real model, set LLM_STUB=0 and these. Ollama runs on your machine with
# no account and no cost: install from ollama.com, then  ollama pull qwen3.5:4b
# LLM_BASE_URL=http://localhost:11434/v1/
# LLM_API_KEY=ollama                    # ignored by Ollama, but the client needs something
# LLM_MODEL=qwen3.5:4b
# A hosted provider instead? Change the same three lines and nothing else.

# qwen3.5 "thinks" before answering; with a 4-token answer budget the thinking
# uses it all and the answer comes back empty. Remove for providers that reject it.
LLM_REASONING_EFFORT=none

# Milliseconds before giving up on one model call. The SDK default is ten minutes.
LLM_TIMEOUT_MS=30000
