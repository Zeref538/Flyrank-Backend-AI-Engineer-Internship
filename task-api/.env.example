# Copy to .env:  cp .env.example .env
# .env is git-ignored (and docker-ignored) and must stay that way.

# --- Database (BE-04) ----------------------------------------------------------
# One password, used by both the Postgres container and the app. compose.yaml
# reads it from here, so no credential is written in any committed file.
POSTGRES_PASSWORD=dev

# For running the app on your own machine against the Postgres container.
# Inside docker compose this is replaced automatically with host `db`: each
# container has its own localhost, so there localhost would mean "myself".
DATABASE_URL=postgres://postgres:dev@localhost:5432/tasks
# Comment DATABASE_URL out to fall back to the SQLite file.

# --- POST /triage (BE-07) ------------------------------------------------------
# LLM_STUB=1 answers with keyword rules: no model, no network, no spending.
LLM_STUB=1

# Set LLM_STUB=0 for a real model. These three lines are the entire difference
# between a model on your laptop and one in a datacentre.
#
# Ollama (the lane this project uses): runs on your machine, no account, no key,
# no daily cap. Install from ollama.com, then: ollama pull qwen3.5:4b
# LLM_BASE_URL=http://localhost:11434/v1/
# LLM_API_KEY=ollama                 # ignored by Ollama, but the client needs something
# LLM_MODEL=qwen3.5:4b
#
# From inside Docker, the model is on the host machine, not in the container:
# LLM_BASE_URL=http://host.docker.internal:11434/v1/
#
# A hosted provider instead? Change the same three values and nothing else.
# OpenRouter needs a key AND both switches ON at openrouter.ai/settings/privacy,
# or every free model answers 404. Free tier is 20/minute and 50/day.

# qwen3.5 "thinks" before answering. For a four-field label that is ~7s and
# ~100 tokens a call for no better answer, so switch it off. Remove this line
# for a provider that rejects the field.
LLM_REASONING_EFFORT=none

# Seconds before giving up on the model. The OpenAI SDK default is TEN MINUTES.
LLM_TIMEOUT=30

# The kill switch. false = answer instantly with a fallback, make zero calls.
LLM_ENABLED=true
